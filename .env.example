# Copy to .env
DATABASE_URL="file:./dev.db"

AUTH_SECRET="change-me-openssl-rand-base64-32"
AUTH_DEV_PASSWORD="dev"
# Comma-separated emails that are always granted ADMIN on sign-in
AUTH_ADMIN_EMAILS="admin@nexashop.dev"
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Shop-wide currency internationalization (one of NGN, USD, GBP, EUR).
# All stored prices are integer minor units; display + Stripe use this currency.
NEXT_PUBLIC_DEFAULT_CURRENCY="NGN"
# Optional display-locale override (e.g. en-NG, en-US, en-GB). Falls back per-currency.
NEXT_PUBLIC_DEFAULT_LOCALE="en-NG"
# Free-shipping progress threshold in minor units (5000 = ₦50.00 / $50.00).
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD_CENTS="5000"

RESEND_API_KEY=""
# Optional sender for password-reset emails (default: NexaShop <onboarding@resend.dev>)
RESEND_FROM="NexaShop <onboarding@resend.dev>"
